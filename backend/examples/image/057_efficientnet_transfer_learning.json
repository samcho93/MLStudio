{
  "meta": {
    "id": 57,
    "title": "EfficientNetB0 Transfer Learning",
    "title_ko": "EfficientNetB0 전이학습",
    "category": "image",
    "difficulty": "intermediate",
    "description": "Use pretrained EfficientNetB0 with frozen weights and GlobalAveragePooling2D for efficient image classification.",
    "description_ko": "EfficientNetB0 사전학습 모델의 가중치를 고정(frozen)한 상태에서 GlobalAveragePooling2D와 Dense 헤드만 학습하여 효율적으로 분류합니다.",
    "tags": [
      "transfer-learning",
      "efficientnet",
      "frozen-backbone",
      "global-avg-pool",
      "efficient"
    ],
    "estimated_time": "15분",
    "dataset_info": {
      "name": "Flower Dataset",
      "source": "custom folder",
      "samples": 4000,
      "features": "224x224x3",
      "classes": 5
    },
    "learning_objectives": [
      "EfficientNet 아키텍처의 특징 이해",
      "Frozen backbone을 사용한 특징 추출(feature extraction) 방식",
      "GlobalAveragePooling2D로 특징 맵을 벡터로 변환",
      "적은 학습 파라미터로 빠르게 분류기 구성",
      "파인튜닝과 특징 추출 방식의 차이"
    ],
    "guide_steps": [
      {
        "step": 1,
        "node": "ImageFolder_1",
        "text": "꽃 이미지 폴더를 로드합니다. EfficientNetB0에 맞춰 224x224 크기로 설정합니다."
      },
      {
        "step": 2,
        "node": "TrainValSplit_1",
        "text": "학습(80%)과 검증(20%)으로 분할합니다."
      },
      {
        "step": 3,
        "node": "PretrainedModel_1",
        "text": "EfficientNetB0을 로드합니다. trainable=false로 backbone 가중치를 고정합니다."
      },
      {
        "step": 4,
        "node": "GlobalAveragePooling2D_1",
        "text": "EfficientNet 출력 특징 맵의 공간 차원을 평균 풀링하여 1D 벡터로 변환합니다."
      },
      {
        "step": 5,
        "node": "Dense_1",
        "text": "128개 뉴런 은닉층으로 특징을 분류에 적합하게 변환합니다."
      },
      {
        "step": 6,
        "node": "Dense_2",
        "text": "5개 꽃 종류에 대한 softmax 출력입니다."
      },
      {
        "step": 7,
        "node": "Trainer_1",
        "text": "backbone이 고정되어 있어 학습이 빠릅니다. Dense 헤드만 학습합니다."
      }
    ],
    "requires_phase": 2
  },
