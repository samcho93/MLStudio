{
  "meta": {
    "id": 65,
    "title": "Satellite Image Land Classification",
    "title_ko": "위성 이미지 토지 분류",
    "category": "image",
    "difficulty": "intermediate",
    "description": "Classify land types (urban, forest, water, agriculture) from satellite images using a deep 4-layer CNN with BatchNorm.",
    "description_ko": "4개의 Conv2D 레이어와 BatchNorm을 사용하여 위성 이미지에서 토지 유형(도시, 산림, 수면, 농경지)을 분류합니다.",
    "tags": [
      "satellite",
      "land-classification",
      "remote-sensing",
      "cnn",
      "batch-norm"
    ],
    "estimated_time": "20분",
    "dataset_info": {
      "name": "Satellite Land Use Dataset",
      "source": "custom folder",
      "samples": 8000,
      "features": "64x64x3",
      "classes": 4
    },
    "learning_objectives": [
      "위성 이미지 데이터의 특성 이해",
      "BatchNormalization의 역할과 효과",
      "깊은 CNN에서 BatchNorm 배치 방법",
      "다중 클래스 분류를 위한 모델 구성",
      "원격 탐사(Remote Sensing) 데이터 처리"
    ],
    "guide_steps": [
      {
        "step": 1,
        "node": "ImageFolder_1",
        "text": "위성 이미지를 로드합니다. urban, forest, water, agriculture 하위 폴더로 구성됩니다."
      },
      {
        "step": 2,
        "node": "TrainValSplit_1",
        "text": "학습(80%)과 검증(20%)으로 분할합니다."
      },
      {
        "step": 3,
        "node": "Conv2D_1",
        "text": "32개 필터로 위성 이미지의 기본 색상, 텍스처 패턴을 추출합니다."
      },
      {
        "step": 4,
        "node": "BatchNorm_1",
        "text": "BatchNormalization: 각 레이어의 입력 분포를 정규화하여 학습을 안정화합니다."
      },
      {
        "step": 5,
        "node": "Conv2D_4",
        "text": "4번째 합성곱층까지 깊어지며 토지 유형별 고수준 패턴을 학습합니다."
      },
      {
        "step": 6,
        "node": "Dense_2",
        "text": "4개 토지 유형에 대한 softmax 출력입니다."
      },
      {
        "step": 7,
        "node": "Trainer_1",
        "text": "BatchNorm 덕분에 더 높은 학습률을 사용해도 안정적으로 학습됩니다."
      }
    ],
    "requires_phase": 1
  },
