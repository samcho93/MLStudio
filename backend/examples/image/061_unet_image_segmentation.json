{
  "meta": {
    "id": 61,
    "title": "U-Net Image Segmentation",
    "title_ko": "이미지 세그멘테이션 (U-Net)",
    "category": "image",
    "difficulty": "advanced",
    "description": "Build a U-Net architecture with encoder-decoder structure and skip connections for pixel-wise image segmentation.",
    "description_ko": "인코더-디코더 구조와 Skip Connection을 활용한 U-Net 아키텍처로 픽셀 단위 이미지 세그멘테이션을 수행합니다.",
    "tags": [
      "segmentation",
      "u-net",
      "encoder-decoder",
      "skip-connection",
      "conv2d-transpose"
    ],
    "estimated_time": "25분",
    "dataset_info": {
      "name": "Segmentation Dataset",
      "source": "custom folder (images + masks)",
