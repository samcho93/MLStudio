      "features": "128x128x3",
      "classes": 2
    },
    "learning_objectives": [
      "U-Net 아키텍처의 인코더-디코더 구조 이해",
      "Skip Connection(Add)의 역할과 효과",
      "Conv2DTranspose를 사용한 업샘플링",
      "픽셀 단위 분류(세그멘테이션)의 개념",
      "이진 세그멘테이션을 위한 손실 함수 선택"
    ],
    "guide_steps": [
      {
        "step": 1,
        "node": "ImageFolder_1",
        "text": "원본 이미지와 세그멘테이션 마스크를 로드합니다."
      },
      {
        "step": 2,
        "node": "Conv2D_1",
        "text": "인코더 첫 번째 블록: 32개 필터로 저수준 특징을 추출합니다."
      },
      {
        "step": 3,
        "node": "Conv2D_2",
        "text": "인코더 두 번째 블록: 64개 필터로 축소된 특징 맵을 생성합니다."
      },
      {
        "step": 4,
        "node": "Conv2DTranspose_1",
        "text": "디코더: Conv2DTranspose로 특징 맵을 업샘플링하여 원본 크기로 복원합니다."
      },
      {
        "step": 5,
        "node": "Add_1",
        "text": "Skip Connection: 인코더의 얕은 특징과 디코더의 업샘플링된 특징을 더해 세밀한 정보를 보존합니다."
      },
      {
        "step": 6,
        "node": "Conv2D_3",
        "text": "최종 1x1 합성곱: 각 픽셀을 전경/배경으로 분류합니다."
      },
      {
        "step": 7,
        "node": "Trainer_1",
        "text": "binary_crossentropy로 픽셀 단위 분류를 학습합니다."
      }
    ],
    "requires_phase": 3
  },
