{
  "meta": {
    "id": 80,
    "title": "Chatbot Intent Classification",
    "title_ko": "챗봇 의도 분류",
    "category": "nlp",
    "difficulty": "intermediate",
    "description": "Classify user utterances into intent categories for a chatbot system using LSTM with word embeddings.",
    "description_ko": "단어 임베딩과 LSTM을 사용하여 챗봇 시스템의 사용자 발화를 의도 카테고리로 분류합니다.",
    "tags": [
      "nlp",
      "intent-classification",
      "chatbot",
      "lstm",
      "embedding",
      "multi-class"
    ],
    "estimated_time": "15min",
    "dataset_info": {
      "name": "ATIS Intent Dataset",
      "source": "atis-intent",
      "samples": 5500,
      "features": "text (user utterances)",
      "target": "intent (0~20: flight, airfare, ground_service, etc.)"
    },
    "learning_objectives": [
      "챗봇 의도 분류 태스크의 특성과 실제 응용을 이해한다",
      "짧은 텍스트 입력에 적합한 임베딩 및 LSTM 설정 방법을 학습한다",
      "다중 클래스 분류에서 클래스 수가 많을 때의 학습 전략을 익힌다",
      "소규모 데이터셋에서 효과적인 모델 학습 방법을 이해한다"
    ],
    "guide_steps": [
      {
        "step": 1,
        "node": "csv_loader_01",
        "text": "ATIS 의도 분류 데이터셋을 로드합니다. 사용자 발화와 의도 레이블을 포함합니다."
      },
      {
        "step": 2,
        "node": "Embedding",
        "text": "5000개 어휘를 64차원 벡터로 변환합니다. 발화는 짧으므로 max_length=40으로 설정합니다."
      },
      {
        "step": 3,
        "node": "LSTM",
        "text": "64 유닛의 LSTM으로 발화의 순차적 의미를 인코딩합니다."
      },
      {
        "step": 4,
        "node": "Dense",
        "text": "21개 유닛과 소프트맥스로 의도를 분류합니다."
      },
      {
        "step": 5,
        "node": "Trainer",
        "text": "sparse_categorical_crossentropy로 25 에폭 학습합니다."
      }
    ],
    "requires_phase": 2
  },
  "nodes": [
